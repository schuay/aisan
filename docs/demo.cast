Bdirectory,\"\u001b[15Gwhich\u001b[21Gis\u001b[24Gwhat\u001b[29Ga\u001b[31Gpath\u001b[36Gmasked\u001b[43Gout\u001b[47Gof\u001b[50Gthe\u001b[54Gbox's\u001b[60Gmount\u001b[66Gnamespace\u001b[76Glooks\u001b[82Glike\u001b[87Gfrom\u001b[92Ginside\u001b[99G\u2014\r\u001b[2C\u001b[1Bi\u001b[5G is \u001b[10Got \u001b[14Gvidence abo\u001b[26Gt whether\u001b[36Gthose fil\u001b[46Gs exis\u001b[53G on the host. The third\u001b[77Gis a DNS\u001b[86Gresolution\u001b[28;1H\u001b[26;3H\u001b[?25h\u001b[?2026l"]
